<%-- Cabecera común: se incluye con <%@ include %> después de definir ${titulo} y ${seccion} --%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${titulo}"/> · Depósitos</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css">
</head>
<body>
<header class="barra">
    <a class="marca-app" href="${pageContext.request.contextPath}/">Depósitos</a>
    <nav>
        <a href="${pageContext.request.contextPath}/depositos" class="${seccion == 'depositos' ? 'activo' : ''}">Depósitos</a>
        <a href="${pageContext.request.contextPath}/estantes" class="${seccion == 'estantes' ? 'activo' : ''}">Estantes</a>
        <a href="${pageContext.request.contextPath}/productos" class="${seccion == 'productos' ? 'activo' : ''}">Productos</a>
        <a href="${pageContext.request.contextPath}/marcas" class="${seccion == 'marcas' ? 'activo' : ''}">Marcas</a>
        <a href="${pageContext.request.contextPath}/categorias" class="${seccion == 'categorias' ? 'activo' : ''}">Categorías</a>
        <a href="${pageContext.request.contextPath}/stock" class="${seccion == 'stock' ? 'activo' : ''}">Stock</a>
    </nav>
</header>
<main>
<c:if test="${not empty sessionScope.flashMensaje}">
    <div class="alerta ${sessionScope.flashTipo}"><c:out value="${sessionScope.flashMensaje}"/></div>
    <c:remove var="flashMensaje" scope="session"/>
    <c:remove var="flashTipo" scope="session"/>
</c:if>
<c:if test="${not empty error}">
    <div class="alerta error"><c:out value="${error}"/></div>
</c:if>
